# Copy to .env and adjust for local development. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=hzt
POSTGRES_PASSWORD=hzt_dev_password
POSTGRES_DB=hzt
POSTGRES_PORT=5432

# --- Cache / pub-sub ---
REDIS_PORT=6379

# --- Vector store (Memory Engine / RAG) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Backend API ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
JWT_SIGNING_KEY=replace-with-a-32-byte-minimum-random-secret
JWT_ISSUER=hermes-zone-torba
JWT_AUDIENCE=hermes-zone-torba-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# --- Frontend ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5080/hubs

# --- Local LLM providers ---
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_HOST=http://localhost:1234
VLLM_HOST=http://localhost:8000

# --- Optional cloud model providers (bring your own key) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SEQ_URL=http://localhost:5341
