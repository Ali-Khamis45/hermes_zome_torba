{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Zone Torba",
  "version": "0.1.0",
  "identifier": "dev.hermeszonetorba.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../frontend",
    "beforeBuildCommand": "npm run build --prefix ../../frontend",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermes Zone Torba",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5080 ws://localhost:5080"
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "Hermes Zone Torba"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ali-Khamis45/hermes_zome_torba/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
